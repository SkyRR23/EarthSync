{
  "$defs": {
    "Context": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "assistant.v1-proposal",
          "default": "assistant.v1-proposal",
          "title": "Schema Version",
          "type": "string"
        },
        "context_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "approximate_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selected_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_farm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 120,
          "title": "Evidence",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "maxItems": 30,
          "title": "Decisions",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 100,
          "title": "Sources",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "context_id"
      ],
      "title": "Context",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported_by_supplied_evidence",
            "conflicts_with_supplied_evidence",
            "insufficient_information",
            "unsuitable",
            "requires_agronomic_validation",
            "supported",
            "conditional",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "scenario_id",
        "status"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "enum": [
            "climate",
            "rainfall",
            "temperature",
            "soil",
            "vegetation",
            "radar",
            "photo",
            "farmer_input"
          ],
          "title": "Topic",
          "type": "string"
        },
        "metric": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observed",
            "modeled",
            "forecast",
            "farmer_reported",
            "synthetic",
            "unavailable"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quality": {
          "enum": [
            "available",
            "missing",
            "partial",
            "stale",
            "contradictory",
            "unavailable",
            "unverified"
          ],
          "title": "Quality",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "spatial_support": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spatial Support"
        },
        "scope": {
          "enum": [
            "regional",
            "field",
            "unlocated"
          ],
          "title": "Scope",
          "type": "string"
        },
        "location_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        },
        "calculation": {
          "default": "none",
          "enum": [
            "none",
            "rust"
          ],
          "title": "Calculation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "topic",
        "metric",
        "kind",
        "quality",
        "scope"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Point",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "point": {
          "$ref": "#/$defs/Point"
        },
        "boundary": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 500,
          "title": "Boundary",
          "type": "array"
        }
      },
      "required": [
        "id",
        "point"
      ],
      "title": "Selection",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "title": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "provider",
        "title"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "assistant.v1-proposal",
      "default": "assistant.v1-proposal",
      "title": "Schema Version",
      "type": "string"
    },
    "question": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "language": {
      "default": "en",
      "enum": [
        "en",
        "es"
      ],
      "title": "Language",
      "type": "string"
    },
    "expanded": {
      "default": false,
      "title": "Expanded",
      "type": "boolean"
    },
    "context": {
      "$ref": "#/$defs/Context"
    }
  },
  "required": [
    "question",
    "context"
  ],
  "title": "ChatRequest",
  "type": "object"
}
