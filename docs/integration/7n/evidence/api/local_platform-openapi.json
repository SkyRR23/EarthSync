{
  "components": {
    "schemas": {
      "AssessmentInput": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Evidence Ids",
            "type": "array"
          },
          "farm_id": {
            "format": "uuid",
            "title": "Farm Id",
            "type": "string"
          },
          "pilot_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pilot Id"
          },
          "plans": {
            "items": {
              "$ref": "#/components/schemas/PlanSelection"
            },
            "maxItems": 20,
            "title": "Plans",
            "type": "array"
          },
          "profile_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Profile Ids",
            "type": "array"
          },
          "sequential_field": {
            "default": false,
            "title": "Sequential Field",
            "type": "boolean"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "farm_id",
          "start",
          "end"
        ],
        "title": "AssessmentInput",
        "type": "object"
      },
      "ClimateInput": {
        "additionalProperties": false,
        "properties": {
          "farm_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Farm Id"
          },
          "query": {
            "$ref": "#/components/schemas/ClimateQuery"
          }
        },
        "required": [
          "query"
        ],
        "title": "ClimateInput",
        "type": "object"
      },
      "ClimateQuery": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "power-daily-merra2.v1",
            "default": "power-daily-merra2.v1",
            "title": "Contract Version",
            "type": "string"
          },
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "lineage": {
            "const": "MERRA2",
            "default": "MERRA2",
            "title": "Lineage",
            "type": "string"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "point",
          "start",
          "end"
        ],
        "title": "ClimateQuery",
        "type": "object"
      },
      "Depth": {
        "additionalProperties": false,
        "properties": {
          "bottom_cm": {
            "exclusiveMinimum": 0.0,
            "title": "Bottom Cm",
            "type": "number"
          },
          "top_cm": {
            "minimum": 0.0,
            "title": "Top Cm",
            "type": "number"
          }
        },
        "required": [
          "top_cm",
          "bottom_cm"
        ],
        "title": "Depth",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "data_type": {
            "enum": [
              "observed",
              "modeled",
              "forecast",
              "farmer_reported",
              "reference",
              "synthetic"
            ],
            "title": "Data Type",
            "type": "string"
          },
          "dataset": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Dataset",
            "type": "string"
          },
          "dataset_version": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Dataset Version",
            "type": "string"
          },
          "id": {
            "pattern": "^ev_[a-f0-9]{64}$",
            "title": "Id",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Limitations",
            "type": "array"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/Measurement"
            },
            "maxItems": 5000,
            "title": "Measurements",
            "type": "array"
          },
          "missing_reasons": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Missing Reasons",
            "type": "array"
          },
          "provider": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "quality_flags": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Quality Flags",
            "type": "array"
          },
          "response_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Response Sha256",
            "type": "string"
          },
          "review": {
            "enum": [
              "unreviewed",
              "reference_only",
              "reviewed",
              "synthetic"
            ],
            "title": "Review",
            "type": "string"
          },
          "schema_version": {
            "const": "earthsync.evidence.v1.0",
            "default": "earthsync.evidence.v1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "source_identifier": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Identifier",
            "type": "string"
          },
          "source_metadata": {
            "additionalProperties": true,
            "title": "Source Metadata",
            "type": "object"
          },
          "source_url": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "spatial": {
            "$ref": "#/components/schemas/Spatial"
          },
          "temporal": {
            "$ref": "#/components/schemas/Temporal"
          },
          "usable_for_assessment": {
            "default": false,
            "title": "Usable For Assessment",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "provider",
          "dataset",
          "dataset_version",
          "source_url",
          "source_identifier",
          "data_type",
          "spatial",
          "temporal",
          "measurements",
          "quality_flags",
          "missing_reasons",
          "limitations",
          "review",
          "response_sha256",
          "source_metadata"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Farm": {
