            "title": "Quality",
            "type": "string"
          },
          "statistic": {
            "default": "daily",
            "maxLength": 80,
            "title": "Statistic",
            "type": "string"
          },
          "unit": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "variable": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Variable",
            "type": "string"
          }
