          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "HistoryInput",
        "type": "object"
      },
      "Measurement": {
        "additionalProperties": false,
        "properties": {
          "conversion": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Conversion",
            "type": "string"
          },
          "date": {
            "anyOf": [
              {
                "format": "date",
