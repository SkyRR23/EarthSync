            "type": "string"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "profile_id",
          "start",
          "end"
        ],
        "title": "PlanSelection",
        "type": "object"
      },
      "Point": {
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Point",
        "type": "object"
      },
      "Polygon": {
        "additionalProperties": false,
        "properties": {
          "coordinates": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Polygon",
            "default": "Polygon",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "title": "Polygon",
        "type": "object"
      },
      "SoilInput": {
        "additionalProperties": false,
        "properties": {
          "farm_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Farm Id"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "required": [
          "point"
        ],
        "title": "SoilInput",
        "type": "object"
      },
      "Spatial": {
        "additionalProperties": false,
        "properties": {
          "crs": {
            "const": "EPSG:4326",
            "default": "EPSG:4326",
            "title": "Crs",
            "type": "string"
          },
          "farm_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Farm Id"
          },
          "original_crs": {
            "default": "EPSG:4326",
            "maxLength": 3000,
