          "variable",
          "original_value",
          "original_unit",
          "value",
          "unit",
          "conversion",
          "quality"
        ],
        "title": "Measurement",
        "type": "object"
      },
      "OpticalInput": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
