          "confirmed_on": {
            "format": "date",
            "title": "Confirmed On",
            "type": "string"
          },
          "confirmed_point": {
            "$ref": "#/components/schemas/Point"
          },
          "confirmed_polygon": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Polygon"
              },
