{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:earthsync:crop-knowledge:v1-proposal",
  "title": "EarthSync crop knowledge catalog v1 proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "earthsync.crop-knowledge.v1-proposal"
    },
    "catalog_version": {
      "const": "0.1.0"
    },
    "contract_status": {
      "const": "proposed_pending_7e_review"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "recommendation_eligible": {
      "const": false
