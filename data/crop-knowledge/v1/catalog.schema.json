        "unknown_properties",
        "coverage_limits"
      ]
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "country_code": {
          "enum": [
            "US",
            "AU"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "geography_basis": {
          "const": "named_research_region_not_farm_boundary"
        },
        "profile_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "coverage_status": {
          "enum": [
            "source_reviewed_partial",
            "reference_only_partial"
          ]
        },
        "environmental_data_status": {
          "const": "unavailable"
        },
        "additional_crop_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "country_code",
        "scope",
        "geography_basis",
        "profile_ids",
        "coverage_status",
        "environmental_data_status",
        "additional_crop_gaps",
        "limitations"
      ]
    }
  }
}
