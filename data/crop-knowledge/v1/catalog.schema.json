    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pilots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pilot"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "contract_status",
    "release_date",
    "recommendation_eligible",
    "sources",
    "claims",
    "profiles",
    "pilots"
