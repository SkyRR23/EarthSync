# Preserve captured provider/mirror bytes, including CRLF and original whitespace.
originals/** -text -diff

# These files are byte-hashed by integrity.json. Never apply core.autocrlf.
*.json -text
*.jsonl -text

# Generated review artifacts; the editable sources and tools remain visible.
catalog.json linguist-generated=true
integrity.json linguist-generated=true
mapping-report.json linguist-generated=true
missing-parameters.json linguist-generated=true
species-inventory.jsonl linguist-generated=true
fixtures/*.json linguist-generated=true
