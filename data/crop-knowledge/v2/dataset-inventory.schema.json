{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 5,
  "maxItems": 5,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "official_urls",
      "source_ids",
      "version",
      "schema",
      "license",
      "license_url",
      "coverage",
      "resolution",
      "units",
      "update_cadence",
      "download_method",
      "restrictions",
      "status",
      "imported"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "official_urls": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "license_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "coverage": {
        "type": "string",
        "minLength": 1
      },
      "resolution": {
        "type": "string",
        "minLength": 1
      },
      "units": {
        "type": "string",
        "minLength": 1
      },
      "update_cadence": {
        "type": "string",
        "minLength": 1
      },
      "download_method": {
        "type": "string",
        "minLength": 1
      },
      "restrictions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "imported": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
