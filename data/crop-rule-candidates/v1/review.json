  "domains": {
    "planting_window": {
      "target_condition": "planting_window",
      "parameters": [
        "planting_window"
      ],
      "reason": "Calendar remains dated advisory context; AEZ label does not locate a farm or establish a safe planting constraint.",
      "required_evidence": [
        "Local extension/agronomist review of crop identity, cultivar, establishment, geography and water regime.",
        "Explicit date convention, relevant year and weather/soil contingency."
      ]
    },
    "growing_duration": {
      "target_condition": "duration",
      "parameters": [
        "growing_duration",
        "ecological_crop_cycle"
      ],
      "reason": "Global species cycles and reported type/calendar durations do not establish inclusive plan duration for a selected cultivar.",
      "required_evidence": [
        "Named cultivar/type, establishment origin, harvest purpose, location and season.",
        "Source versus inclusive end-day convention reconciled."
      ]
    },
    "temperature": {
      "target_condition": "temperature",
      "parameters": [
        "ecological_temperature",
        "daily_extreme_temperature",
        "growing_degree_days"
      ],
      "reason": "Seasonal average Tmin/Tmax envelopes cannot bound each daily extreme; monthly means and GDD are different statistics.",
      "required_evidence": [
        "Original stage/cultivar-specific daily-extreme or thermal-time evidence.",
        "Exact temporal statistic and accepted regional data with full period coverage."
      ]
    },
    "growing_period_rainfall": {
      "target_condition": "growing_period_rainfall",
      "parameters": [
        "annual_precipitation",
        "growing_period_rainfall",
        "water_demand"
      ],
      "reason": "Annual ecological envelopes cannot be prorated into growing-period rainfall, effective rain, ETc or irrigation demand.",
      "required_evidence": [
        "Original crop-season rainfall requirement with period/statistic/system and cultivar.",
        "Separate ETc, effective rain, storage, irrigation and paddy loss accounting where relevant."
      ]
    },
    "soil_ph": {
      "target_condition": "soil_numeric",
      "parameters": [
        "ecological_soil_ph",
        "soil_ph_by_depth",
        "ecological_soil_depth"
      ],
      "reason": "Ecological pH has no accepted depth or chemical method; ecological root depth is not a sample layer.",
      "required_evidence": [
        "Crop requirement at explicit depth and pH method (water/salt).",
        "Representative soil evidence with units, uncertainty and temporal support."
      ]
    },
    "soil_texture": {
      "target_condition": "soil_category",
      "parameters": [
        "soil_texture"
      ],
      "reason": "Qualitative ecological texture categories need a reviewed crosswalk; absence in maize remains unknown.",
      "required_evidence": [
        "Source and engine category vocabulary crosswalk with independent review.",
        "Field representative texture evidence; texture does not establish drainage."
      ]
    },
    "soil_drainage": {
      "target_condition": "soil_category",
      "parameters": [
        "soil_drainage"
      ],
      "reason": "Ecological drainage descriptors do not establish present field drainage or flood tolerance.",
      "required_evidence": [
        "Reviewed category vocabulary and production-system-specific constraint.",
        "Attributed field drainage/landform/water-table evidence; no soil-colour proxy."
      ]
    },
    "flood_tolerance": {
      "target_condition": null,
      "parameters": [
        "flooding_tolerance",
        "flooded_management",
        "irrigation_requirements"
      ],
      "reason": "No validated stage-specific flood depth, duration or recovery threshold; irrigation and paddy culture do not prove submergence tolerance.",
      "required_evidence": [
        "Original cultivar/stage-specific flood experiments and quantitative exposure definition.",
        "Separate rice upland, lowland, delayed flooding and management regimes; v0.3 has no flood-injury requirement."
      ]
    },
    "drought_stage_sensitivity": {
      "target_condition": null,
      "parameters": [
        "drought_tolerance",
        "stage_vulnerabilities"
      ],
      "reason": "Training sensitivity classes lack quantitative drought exposure and crop-stage dates; generic tolerance cannot waive water requirements.",
      "required_evidence": [
        "Stage/cultivar-specific intensity-duration evidence and uncertainty.",
        "Validated phenology and soil-water exposure; v0.3 has no stage-injury condition."
      ]
    },
    "kc_curve": {
      "target_condition": "crop_evapotranspiration",
      "parameters": [
        "kc_stages",
        "et0_method"
      ],
      "reason": "Source Kc rows require local adjustments and endpoint selection; v0.3 constant stages cannot silently replace FAO-56 linear transitions.",
      "required_evidence": [
        "Applicable Kc initial/wetting and mid/end climate/height corrections.",
        "Locally reviewed day-indexed linear curve encoding and aligned daily grass-reference ETo.",
        "Review that ETc is standard-condition demand, not rainfall/irrigation sufficiency."
      ]
    },
    "stage_duration": {
      "target_condition": "crop_evapotranspiration",
      "parameters": [
        "kc_stages",
        "growing_duration"
      ],
      "reason": "Table 11 stages are regional examples needing local validation; they do not fill calendar-profile stage offsets automatically.",
      "required_evidence": [
        "Validated crop/cultivar stage lengths with establishment origin and actual season.",
        "Resolve any source total disagreement before daily indexing."
      ]
    },
    "succession": {
      "target_condition": "succession",
      "parameters": [
        "succession",
        "crop_history_relationships"
      ],
      "reason": "Published sequences and general family identity do not establish mandatory predecessor or numerical fallow requirements.",
      "required_evidence": [
        "Original system/location-specific predecessor and fallow evidence.",
        "Complete attributed confirmed-field history; elapsed gap is not proof of fallow.",
        "Separate rotation from intercropping; independently substantiate any N/pest/yield claim."
      ]
    }
  },
