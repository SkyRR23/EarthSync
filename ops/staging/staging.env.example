# Reference only. staging.py generates these values from its verified manifest;
# it does not source .env files. Never put this file in Flutter assets.
# Use DIFFERENT private state directories/venvs for web and platform; both use the combined 7N lock.
EARTHSYNC_PLATFORM_LOCAL=1
EARTHSYNC_PLATFORM_DIR=/absolute/private/platform-state/data
EARTHSYNC_PLATFORM_ORIGINS=http://127.0.0.1:8080
EARTHSYNC_V03_EXECUTABLE=/absolute/path/to/engine/target/release/examples/v03_demo
EARTHSYNC_V03_SHA256=REVIEW_THE_MANIFEST_SHA256
EARTHSYNC_CATALOG_PATH=/absolute/path/to/data/crop-knowledge/v1/catalog.json
EARTHSYNC_CATALOG_SHA256=REVIEW_THE_MANIFEST_SHA256
EARTHSYNC_EVIDENCE_DIR=/absolute/private/web-state/data
EARTHSYNC_EVIDENCE_TOKEN_FILE=/absolute/private/web-state/data/workspace-token.txt
EARTHSYNC_DIAGNOSTICS=0
# Bind: 127.0.0.1; one worker; proxy headers disabled. No public/private-route proxy.
# No token value, provider credentials, mock/captured switch or wildcard origin.
