# Explicit local-only demo. Hosted multi-user APIs remain disabled.
EARTHSYNC_PLATFORM_LOCAL=1
# Must be an absolute private directory, never committed or web-served.
EARTHSYNC_PLATFORM_DIR=/absolute/private/earthsync-platform
EARTHSYNC_PLATFORM_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Actual compiled PR #18 v03_demo --stdin, fixed path and expected SHA-256.
EARTHSYNC_V03_EXECUTABLE=/absolute/path/to/v03_demo
EARTHSYNC_V03_SHA256=replace-with-reviewed-executable-sha256
# Optional exact PR #15 catalog, retain reference-only eligibility.
EARTHSYNC_CATALOG_PATH=/absolute/path/to/catalog.json
EARTHSYNC_CATALOG_SHA256=replace-with-reviewed-catalog-sha256
