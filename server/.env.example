# No credentials required. Environment files are not automatically loaded.
# Uvicorn bind options can be supplied on the command line:
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Opt-in fixed-public-point live checks. Set in the shell before server startup.
# Do not enable developer diagnostics on a public deployment.
EARTHSYNC_DIAGNOSTICS=0
